---
import reference from '../data/game-reference.json';
interface Props { heroId?: number; side?: boolean; }
const { heroId, side = false } = Astro.props;
const slugs: Record<number, string> = { 0: 'joao', 1: 'catalina', 2: 'otto', 3: 'ernst', 4: 'pietro', 5: 'ali', 6: 'milanda', 7: 'haegang', 8: 'mateo' };
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const sideHero = reference.sideHeroes.find(row => row.id === heroId);
const hero = reference.heroes.find(row => row.id === heroId) ?? sideHero;
const rows = (sideHero ? reference.sideChallenges : reference.challenges).filter(row => row.heroId === heroId);
const fameFor = (id: number) => reference.challenges.find(row => row.id === `hero${id}.primary_fame_1000`)!.description.split(' ')[0];
if (heroId !== undefined && !hero) throw new Error(`Unknown challenge hero: ${heroId}`);
---
{hero ? <>
 {sideHero
  ? <p><strong>{hero.name}</strong>의 외전 도전과제 {rows.length}개입니다. 외전을 하는 동안의 기록으로 판정하며, 본편 여섯 선장의 합계·순위와 따로 기록합니다.</p>
  : <p><strong>{hero.name}</strong>의 도전과제 {rows.length}개입니다. 전문 명성은 <strong>{fameFor(hero.id)} 명성</strong>으로 판정하며, 다른 캐릭터의 진행과 별도로 기록합니다.</p>}
 <p class="reference-summary">좁은 화면에서는 표를 좌우로 밀어 모든 조건을 확인할 수 있습니다.</p>
 <div class="reference-scroll" tabindex="0" role="region" aria-label={`${hero.name}의 도전과제`}>
 <table><thead><tr><th scope="col">분류</th><th scope="col">목표</th><th scope="col">완료 조건</th><th scope="col">목표값</th></tr></thead>
 <tbody>{rows.map(row=><tr data-challenge-id={row.id}><td>{row.category}</td><th scope="row">{row.name}</th><td>{row.description}</td><td>{row.target.toLocaleString('ko-KR')}</td></tr>)}</tbody></table>
 </div>
</> : side ? <nav aria-label="외전 주인공 도전과제 목록">
 <ul>{reference.sideHeroes.map(hero => <li id={`challenge-hero-${hero.id}`}>
  <a href={`${base}/challenges/${slugs[hero.id]}/`}><strong>{hero.name} 도전과제</strong></a>
  {' — '}{reference.sideChallenges.filter(row => row.heroId === hero.id).length}개 · 외전
 </li>)}</ul>
</nav> : <nav aria-label="캐릭터별 도전과제 목록">
 <ul>{reference.heroes.map(hero => <li id={`challenge-hero-${hero.id}`}>
  <a href={`${base}/challenges/${slugs[hero.id]}/`}><strong>{hero.name} 도전과제</strong></a>
  {' — '}{reference.challenges.filter(row => row.heroId === hero.id).length}개 · {fameFor(hero.id)} 명성
 </li>)}</ul>
</nav>}
