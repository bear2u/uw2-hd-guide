---
import type { ImageMetadata } from "astro";
interface Props { stages: { image: ImageMetadata; part: string; title: string }[]; }
const { stages } = Astro.props;
---
<div class="character-stages">
  {stages.map(stage => (
    <figure class="character-stage">
      <img class="stage-portrait" src={stage.image.src} alt={`서만길 ${stage.part} ${stage.title}의 게임 초상화`} width={stage.image.width} height={stage.image.height} loading="lazy" decoding="async" />
      <figcaption class="stage-caption"><span>{stage.part}</span><strong>{stage.title}</strong></figcaption>
    </figure>
  ))}
</div>
<style>
  .character-stages { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 1rem; margin: 1.5rem 0; }
  .character-stage { margin: 0; min-width: 0; }
  .stage-portrait { display: block; width: 100%; height: auto; border: 1px solid var(--nb-border); border-radius: 0.5rem; }
  .stage-caption { display: flex; flex-direction: column; gap: 0.2rem; margin-top: 0.6rem; text-align: center; word-break: keep-all; }
  .stage-caption span { color: var(--nb-muted-foreground); font-size: 0.85rem; }
  @media (max-width: 640px) { .character-stages { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 480px) { .character-stages { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
