---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import catalogue from '@/data/card-decks.json';
const cards = catalogue.cards as Record<string, (typeof catalogue.cards)[keyof typeof catalogue.cards]>;
const artwork = import.meta.glob<{default: ImageMetadata}>('../assets/card-illustrations/*', { eager: true });
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="deck-directory">
  {catalogue.decks.map(deck => {
    const card = cards[deck.hero];
    const art = artwork[`../assets/card-illustrations/${card.image}`].default;
    return <a class="deck-link" href={`${base}/card-game/decks/${deck.slug}/`}>
      <Image src={art} alt={`${deck.name} 대표 영웅`} width={Math.min(240,art.width)} format="webp" quality={80} loading="lazy" />
      <span><small>{deck.kind} · {deck.team} 진영</small><strong>{deck.name}</strong><span>{deck.style}</span><small>영웅 1장 + 덱 20장 · 전체 구성 보기 →</small></span>
    </a>;
  })}
</div>

<style>
  .deck-directory { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 1rem; margin: 1.5rem 0; }
  .deck-link { display: flex; gap: .8rem; align-items: center; padding: .85rem; border: 1px solid #8a806b66; border-radius: .7rem; color: inherit; text-decoration: none; min-width: 0; }
  .deck-link:hover { background: #cba9671a; }
  .deck-link:focus-visible { outline: 3px solid #0987aa; outline-offset: 3px; }
  .deck-link :global(img) { display: block; margin: 0; width: 76px; height: 100px; object-fit: contain; background: #17242d; border-radius: .35rem; flex-shrink: 0; }
  .deck-link>span { display: grid; gap: .3rem; min-width: 0; }
  .deck-link strong { line-height: 1.4; font-size: 1rem; }
  .deck-link span span { font-size: .85rem; }
  .deck-link small { font-size: .75rem; line-height: 1.5; }
  @media(max-width: 700px) { .deck-directory { grid-template-columns: 1fr; } }
</style>
