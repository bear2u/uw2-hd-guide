---
import type { ImageMetadata } from "astro";
interface Props { image: ImageMetadata; name: string; }
const { image, name } = Astro.props;
---
<div class="companion-profile">
  <img class="companion-portrait" src={image.src} alt={`${name}의 게임 초상화`} width={image.width} height={image.height} loading="lazy" decoding="async" />
  <div class="companion-description"><slot /></div>
</div>
<style>
  .companion-profile {
    display: grid;
    grid-template-columns: 112px minmax(0, 1fr);
    gap: 1.25rem;
    align-items: start;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--nb-border);
  }
  .companion-portrait {
    display: block;
    width: 112px;
    height: auto;
    border-radius: 0.5rem;
    border: 1px solid var(--nb-border);
  }
  .companion-description { min-width: 0; }
  .companion-description :global(p) { margin: 0 0 0.75rem; }
  .companion-description :global(p:last-child) { margin-bottom: 0; }
  @media (max-width: 480px) {
    .companion-profile { grid-template-columns: 80px minmax(0, 1fr); gap: 0.875rem; }
    .companion-portrait { width: 80px; }
  }
</style>
