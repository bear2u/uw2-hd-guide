{
  "name": "uw2-hd-manual",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "lint:docs": "nimbus-docs lint",
    "lint:docs:fix": "nimbus-docs lint --fix",
    "prebuild": "node scripts/theme.mjs && node scripts/check-reference.mjs && node scripts/check-public-copy.mjs",
    "build:deploy": "GUIDE_DEPLOY=1 npm run build",
    "check:links": "node scripts/check-links.mjs",
    "test": "node --test scripts/config.test.mjs",
    "postbuild": "node scripts/check-public-copy.mjs --built",
    "check:public": "node scripts/check-public-copy.mjs && node scripts/check-public-copy.mjs --built",
    "build:flow": "node scripts/build-flow.mjs",
    "build:flow-cards": "node scripts/build-flow-cards.mjs",
    "verify:flow": "node scripts/verify-flow.mjs"
  },
  "dependencies": {
    "@cloudflare/nimbus-docs": "0.18.1",
    "@fontsource-variable/jetbrains-mono": "5.2.8",
    "@iconify-json/ph": "1.2.0",
    "astro": "7.3.1",
    "astro-og-canvas": "0.13.0",
    "canvaskit-wasm": "0.41.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.5.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.8",
    "@astrojs/language-server": "2.16.13",
    "@tailwindcss/vite": "4.1.4",
    "pagefind": "1.5.2",
    "tailwindcss": "4.1.4",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
